.gradle/
.kotlin/
build/
local.properties
.idea/
*.iml
captures/
.DS_Store
*.hprof
.gitsecret/keys/random_seed
.gitsecret/keys/*~
!*.secret

# Assinatura de release (ADR 0017): os originais nunca entram no git, so as versoes
# cifradas pelo git-secret (*.jks.secret, keystore.properties.secret).
keystore.properties
*.jks

# Ficha da loja (ADR 0022): as imagens sao copiadas de marketing/ na hora do release,
# nao versionadas duas vezes. O JSON da conta de servico da Play nunca entra no git.
fastlane/metadata/android/*/images/
fastlane/play-service-account.json
fastlane/report.xml
fastlane/README.md
