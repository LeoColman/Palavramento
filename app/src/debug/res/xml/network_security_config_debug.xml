<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds may talk to a local development server over plain HTTP: BuildConfig.SERVER_URL comes
  from the `palavramento.serverUrl` property (local.properties or -P) when it is set, e.g.
  http://10.0.2.2:8080 from the emulator or any LAN address of the developer's machine, so debug
  builds allow cleartext everywhere. The default is the production server over HTTPS. Release builds
  do not ship this file and keep Android's TLS-only default.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
