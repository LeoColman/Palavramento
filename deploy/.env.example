# Copie para /root/manual-stacks/palavramento/.env no servidor (fora do git, chmod 600).
# IMAGE_TAG é gerado pelo deploy.sh a cada build.
APP_HOST=palavramento.colman.com.br
POSTGRES_PASSWORD=troque-esta-senha
# Segredo que assina os tokens JWT. Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
# Token que o Prometheus usa (bearer) para raspar GET /metrics. Sem essa variável o servidor
# responde 404 na rota. Gere com: openssl rand -hex 32
METRICS_TOKEN=troque-este-token
# Domínio onde o Grafana é publicado pelo Caddy.
GRAFANA_HOST=grafana.palavramento.colman.com.br
# Senha do usuário admin do Grafana (login "admin"). Gere com: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Senha dos repositórios Borg (ADR 0021). A mesma para BorgBase e Curupira, e sem ela o backup
# não abre: guarde fora do servidor também.
BORG_PASSPHRASE=troque-esta-senha
