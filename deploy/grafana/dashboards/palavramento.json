{
  "id": null,
  "uid": "palavramento",
  "title": "Palavramento",
  "description": "Jogadores conectados e ativos, contas por tipo, taxa e latência das requisições HTTP do servidor Palavramento.",
  "tags": ["palavramento"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jogadores conectados agora",
      "description": "Jogadores com socket aberto neste momento (palavramento_players_connected).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_connected",
          "legendFormat": "conectados"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jogadores ativos",
      "description": "Jogadores distintos que entraram em rodada nas últimas 24h, 7d e 30d (palavramento_players_active).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"24h\"}",
          "legendFormat": "24h",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"7d\"}",
          "legendFormat": "7d",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"30d\"}",
          "legendFormat": "30d",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jogadores ativos (série temporal)",
      "description": "Mesma métrica de jogadores ativos, ao longo do tempo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"24h\"}",
          "legendFormat": "24h"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"7d\"}",
          "legendFormat": "7d"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_active{window=\"30d\"}",
          "legendFormat": "30d"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Contas por tipo",
      "description": "Contas existentes, convidado e cadastrada (palavramento_players_accounts).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_accounts{kind=\"guest\"}",
          "legendFormat": "convidado",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "palavramento_players_accounts{kind=\"registered\"}",
          "legendFormat": "cadastrada",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taxa de requisições HTTP",
      "description": "Requisições por segundo, por rota e status (ktor_http_server_requests_seconds_count).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, route, status) (rate(ktor_http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência das requisições HTTP",
      "description": "Latência média (soma / contagem) e máxima observada por rota (ktor_http_server_requests_seconds_sum, _count e _max).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route) (rate(ktor_http_server_requests_seconds_sum[5m])) / sum by (route) (rate(ktor_http_server_requests_seconds_count[5m]))",
          "legendFormat": "média {{route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (route) (ktor_http_server_requests_seconds_max)",
          "legendFormat": "máxima {{route}}"
        }
      ]
    }
  ]
}
